  Vistas totales globales: <strong id="vistas">Cargando...</strong> <br>
  Última visita registrada en la nube: <span id="fecha-ultima" style="color: #00ffff;">Cargando...</span>
</div>

<script>
  var miClaveContador = "rolando1804_github_io_vistas_estables_2026";
  var miClaveFecha = "rolando1804_github_io_timestamp_2026";

  function formatearFechaDesdeNumero(timestampNumerico) {
    if (!timestampNumerico || timestampNumerico < 100000) return "Esperando primera visita normal...";
    var ahora = new Date(parseInt(timestampNumerico));
    var dia = String(ahora.getDate()).padStart(2, '0');
    var mes = String(ahora.getMonth() + 1).padStart(2, '0');
    var anio = ahora.getFullYear();
    var horas = String(ahora.getHours()).padStart(2, '0');
    var minutos = String(ahora.getMinutes()).padStart(2, '0');
    return dia + "-" + mes + "-" + anio + " a las " + horas + ":" + minutos;
  }

  function registrarOActualizarVistas() {
    var direccionWeb = window.location.href.toLowerCase();
    var esAdmin = direccionWeb.indexOf("admin") !== -1;
    var apiBase = "https://countapi.mileshilliard.com/api/v1";
    var cacheBuster = "t=" + Date.now();

    if (esAdmin) {
      document.getElementById("bloque-admin").style.display = "block";

      fetch(apiBase + "/get/" + miClaveContador + "?" + cacheBuster)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          document.getElementById("vistas").innerText = data.value !== undefined ? data.value : 0;
        }).catch(function() { document.getElementById("vistas").innerText = "Error"; });

      fetch(apiBase + "/get/" + miClaveFecha + "?" + cacheBuster)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          document.getElementById("fecha-ultima").innerText = data.value ? formatearFechaDesdeNumero(data.value) : "Esperando primera visita normal...";
        }).catch(function() { document.getElementById("fecha-ultima").innerText = "Error de sincronización"; });

    } else {
      var numeroFechaActual = Date.now();
      
      // URLs limpias y nativas para la API sin query strings raros que rompan sendBeacon
      var urlHit = apiBase + "/hit/" + miClaveContador;
      var urlSet = apiBase + "/set/" + miClaveFecha + "?value=" + numeroFechaActual;

      // Para cargas normales de página (Abrir de cero / Recargar) usamos Fetch limpio
      fetch(urlHit, { mode: 'no-cors', cache: 'no-store' });
      fetch(urlSet, { mode: 'no-cors', cache: 'no-store' });
    }
  }

  // 1. DISPARADOR PARA ENTRAR DESDE CERO Y RECARGAS
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", registrarOActualizarVistas);
  } else {
    registrarOActualizarVistas();
  }

  // 2. DISPARADOR PARA SEGUNDO PLANO (Celulares que minimizan la app)
  document.addEventListener("visibilitychange", function() {
    if (document.visibilityState === "visible") {
      // Al volver a abrir la app de forma estática, forzamos un envío limpio
      var apiBase = "https://countapi.mileshilliard.com/api/v1";
      var direccionWeb = window.location.href.toLowerCase();
      if (direccionWeb.indexOf("admin") === -1) {
        fetch(apiBase + "/hit/" + miClaveContador, { mode: 'no-cors', cache: 'no-store' });
        fetch(apiBase + "/set/" + miClaveFecha + "?value=" + Date.now(), { mode: 'no-cors', cache: 'no-store' });
      }
    }
  });
</script>


